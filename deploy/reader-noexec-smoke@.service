[Unit]
Description=Reader r4 real SDK noexec synthetic regression
After=network-online.target var-lib-reader-jobs.mount
BindsTo=var-lib-reader-jobs.mount
Wants=network-online.target
[Service]
Type=oneshot
User=reader-worker
Group=reader-data
UMask=0007
WorkingDirectory=/opt/reader/current
Environment=READER_RUNTIME_CACHE=/opt/reader-runtime-cache-0.2.2rc2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/bwrap --version
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 /opt/reader-runtime/bin/python -m tools.noexec_smoke --parent /var/lib/reader/jobs --data /var/lib/reader/jobs/.r4-%i/data
OOMPolicy=kill
Restart=no
RestartSec=5
KillMode=control-group
TimeoutStartSec=180
RuntimeMaxSec=180
TimeoutStopSec=15
SendSIGKILL=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Bubblewrap requires these namespaces; no broad @system-service syscall filter.
RestrictNamespaces=user pid net ipc uts mnt cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
ReadWritePaths=/var/lib/reader
ReadOnlyPaths=/opt/reader-runtime-cache-0.2.2rc2
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
LimitNOFILE=256
LimitFSIZE=32M
LimitCORE=0
[Install]
WantedBy=multi-user.target
