[Unit]
Description=HTML studio worker beside reader, not a replacement
After=network.target var-lib-studio-jobs.mount
Requires=var-lib-studio-jobs.mount
[Service]
Type=simple
User=studio-worker
Group=studio-data
UMask=0007
WorkingDirectory=/opt/studio/current
EnvironmentFile=/etc/studio/worker.env
UnsetEnvironment=TTS_API_TOKEN
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=READER_RUNTIME_CACHE=/opt/reader-runtime-cache-0.2.2rc2
ExecStart=/opt/reader-runtime/bin/python -m reader_service.studio_worker
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=user pid net ipc uts mnt cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
ReadWritePaths=/var/lib/studio /var/lib/studio/jobs
ReadOnlyPaths=/opt/reader-runtime-cache-0.2.2rc2
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=256
LimitFSIZE=32M
LimitCORE=0
OOMPolicy=kill
[Install]
WantedBy=multi-user.target
