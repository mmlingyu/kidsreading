# /etc/studio/worker.env root:root 0600. Never load this from the API or the browser.
STUDIO_DATA=/var/lib/studio
STUDIO_AUTH_FILE=/etc/reader/owners.json
STUDIO_ENABLE_GENERATION=0
STUDIO_ACCEPTED_FILE=/etc/studio/accepted.json
# The worker reads this once and passes it to the gateway on stdin, then drops it
# from the process environment before starting bwrap. Do not reuse a TTS token.
DEEPSEEK_API_KEY=REPLACE_SECURELY_AT_DEPLOYMENT
# Whole job wall clock, seconds. Hard cap in code is 900.
STUDIO_JOB_TIMEOUT=600
# No new output file for this many seconds stops the process tree. Hard cap is 300.
STUDIO_PROGRESS_TIMEOUT=180
