# /etc/reader/worker.env root:root 0600; systemd loads before dropping UID.
READER_DATA=/var/lib/reader
READER_DATA_GROUP=reader-data
READER_AUTH_FILE=/etc/reader/owners.json
READER_ENABLE_GENERATION=0
READER_RUNTIME_CACHE=/opt/reader-runtime-cache-0.2.2rc2
# Coordinator securely injects key here, not source/CLI args/logs/frontend.
DEEPSEEK_API_KEY=REPLACE_SECURELY_AT_DEPLOYMENT
