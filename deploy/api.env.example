# /etc/reader/api.env root:root 0600. NOT a secret-bearing checked-in .env.
READER_DATA=/var/lib/reader
READER_DATA_GROUP=reader-data
READER_AUTH_FILE=/etc/reader/owners.json
# Exact HTTPS origin including non-default port if applicable. Never '*'.
READER_CORS_ORIGINS=https://124.222.128.61
READER_ENABLE_GENERATION=0
